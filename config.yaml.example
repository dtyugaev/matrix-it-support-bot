# =============================================================================
# matrix-it-support-bot — конфигурация ИТ бота службы технической поддержки ОТР
# =============================================================================

matrix:
  # Базовый URL сервера Matrix Synapse
  homeserver: ""
  # Matrix ID учётной записи бота
  user_id: ""
  # Токен доступа бота
  access_token: ""
  # Идентификатор устройства бота для сессии Synapse
  device_id: ""
  # Резервный токен с правами администратора сервера для Admin API
  admin_access_token: ""
  # Автоматически принимать приглашения в комнаты
  auto_join: true
  # Таймаут long-poll синхронизации с Synapse, мс
  sync_timeout: 30000
  # Поддержка сквозного шифрования комнат (E2EE)
  encryption: false
  # Каталог хранилища библиотеки matrix-nio
  nio_store_path: "storage/nio_store"
  # Таймаут одного HTTP-запроса к Synapse, с
  request_timeout: 30
  # Количество повторных попыток при сетевой ошибке Synapse
  max_retries: 5
  # Множитель задержки между повторными попытками Synapse
  retry_backoff: 2.0

database:
  # Используемая БД: sqlite или postgresql
  type: "postgresql"
  sqlite:
    # Файл базы данных SQLite
    path: "storage/bot.db"
  postgresql:
    # Хост сервера PostgreSQL
    host: ""
    # Порт сервера PostgreSQL
    port: 5432
    # Имя базы данных
    dbname: ""
    # Пользователь базы данных
    user: ""
    # Пароль пользователя базы данных
    password: ""
    # Таймаут установки соединения с PostgreSQL, с
    connect_timeout: 10
  # Количество повторных попыток подключения к БД
  max_retries: 5
  # Множитель задержки между попытками подключения к БД
  retry_backoff: 2.0

logging:
  # Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
  level: "INFO"
  # Файл журнала (ротация не выполняется)
  file_path: "storage/matrix-it-support-bot.log"
  # Дублировать журнал в стандартный вывод
  console: false
  # Формат строки журнала
  format: "%(asctime)s %(levelname)-8s [%(name)s] %(message)s"
  # Формат метки времени в журнале
  date_format: "%Y-%m-%d %H:%M:%S"
  # Логгеры библиотек, приглушённые до уровня WARNING
  quiet_loggers:
    - "nio"
    - "urllib3"
    - "asyncio"
    - "aiohttp"

jira:
  # Базовый URL Jira
  url: "https://jira-kis.otr.ru"
  # Сервисный логин Jira, от имени которого работает бот
  login: ""
  # Пароль сервисной учётной записи Jira
  password: ""
  # Проверять SSL сертификат при подключении к Jira
  verify_ssl: false
  # Ключ проекта Jira, в котором создаются заявки
  project: "IT"
  # Идентификатор типа создаваемой заявки
  issue_type_id: "10000"
  # Ссылка на портал заявок для пользователя
  portal_url: "https://jira-kis.otr.ru/servicedesk/customer/portal/6"
  # REST-endpoint плагина Jira Status Listener
  status_listener_url: "https://jira-kis.otr.ru/rest/flr/latest/new-status/"
  # Частота опроса Jira и плагина уведомлений, с
  poll_interval_seconds: 60
  # Глубина времени выборки изменений заявок в опросе Jira, мин
  poll_lookback_minutes: 15
  # Идентификаторы статусов заявок, попадающих в «Список моих заявок»
  issue_types_for_list:
    - "10002"  # Отложено
    - "10005"  # Запрос информации
    - "10006"  # Спам
    - "10017"  # В работе
#    - "10508" # Закрыто
    - "10900"  # Зарегистрировано
    - "10901"  # Ожидает решения
    - "10902"  # Ответ предоставлен
#    - "10903" # Предложено решение
    - "10904"  # Переоткрыто
    - "12000"  # Согласование ФЗ
    - "14200"  # Передано на 3 линию
    - "14300"  # Согласование УИБ
    - "14301"  # Прокомментировано УИБ

  # Количество заявок на одной странице списка
  issues_per_page: 5
  # Максимальное количество страниц пагинации
  issues_max_pages: 10
  # Сколько последних комментариев показывать в карточке заявки
  comments_per_issue: 3
  # Порядок комментариев в карточке заявки: desc (новые сверху) или asc (старые сверху)
  comments_sort_order: "desc"
  # Разрешать пункт «Добавить комментарий» во всех статусах заявки
  always_allow_comment: true
  # Таймаут одного HTTP-запроса к Jira, с
  request_timeout: 30
  # Количество повторных попыток при сетевой ошибке Jira
  max_retries: 4
  # Множитель задержки между повторными попытками Jira
  retry_backoff: 2.0
  # Максимальная длина темы заявки
  subject_max_length: 255
  # Удалять обработанные события в плагине Jira Status Listener
  delete_processed_events: true
  # Включить резервный JQL-опрос, если плагин недоступен
  fallback_poll_enabled: true
  # Уведомлять о любой смене статуса, а не только о ключевых
  notify_all_status_changes: true

  # Вложения из заявок в zip-архиве
  attachments:
    # Каталог для архивов вложений и файлов пользователей
    dir: "storage/attachments"
    # Шаблон имени zip-архива вложений
    zip_filename_format: "%(issue_key).zip"
    # Максимальный размер одного файла, МБ
    max_size: 30
    # Время жизни отправленного архива до автоудаления, с
    attachment_ttl: 604800
    # Частота работы сборщика мусора вложений, с
    cleanup_interval: 300
    # Удалять сообщение с архивом из комнаты Matrix
    delete_from_room: true
    # Удалять локальный файл архива из каталога бота
    delete_from_bot_dir: true
    # Удалять файл из медиа-хранилища Synapse через Admin API
    delete_from_synapse: true

menu:
  # Выводить пункты меню списком, иначе обычным текстом
  menu_items_as_list: true
  # Выводить команды в разделе «Помощь» списком
  help_commands_as_list: true
  # Разметка сообщений бота: markdown, html или plain
  markup: "markdown"
  # Выводить заголовок меню жирным шрифтом
  title_bold: true
  # Добавлять в карточку заявки ссылку на портал Jira
  show_portal_link: true

administration:
  # Комната администраторов бота, куда идут служебные события
  admin_room_id: ""
  # Администраторы бота (Matrix ID)
  admins:
    - "@tyugaev.dmitrii:otr.ru"
  # Контакт поддержки, подставляемый в тексты ошибок
  support_email: "it@otr.ru"
  # Какие события пересылать в комнату администраторов
  notify_events:
    # Запуск бота
    bot_started: true
    # Остановка бота
    bot_stopped: true
    # Регистрация пользователя в комнате
    user_registered: true
    # Удаление профиля или выход пользователя
    user_deleted: true
    # Не найден профиль в БД при рассылке уведомления
    profile_not_found: false
    # Создание заявки пользователем
    issue_created: false
    # Новое обращение обратной связи
    feedback: true
    # Ошибка обращения к Jira
    jira_error: true
    # Ошибка обращения к Synapse
    matrix_error: true
    # Ошибка автоочистки вложений
    attachment_cleanup_error: true
    # Сообщение от чужого пользователя в закреплённой комнате
    room_hijack_attempt: false
